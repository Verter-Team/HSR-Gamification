POSTGRES_USER=vsm
POSTGRES_DB=vsm
POSTGRES_PASSWORD=replace-with-random-alphanumeric-password
JWT_SECRET=replace-with-long-random-secret-at-least-32-characters
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000
# Приложение проводника. 0.0.0.0 - доступно с телефонов в той же сети
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
PUBLIC_BASE_URL=https://vsm.local
CORS_ORIGIN=
# 1 - API стоит за nginx (контейнер web), лимит входа считается по IP телефона
TRUST_PROXY=1
