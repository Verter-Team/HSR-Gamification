        {
          "id": "a",
          "text": "Помочь разместить чемодан в багажном отсеке у входа и объяснить, где он будет стоять",
          "effects": [
            {
              "op": "metric",
              "metric": "safety",
              "delta": 10
            },
            {
              "op": "metric",
              "metric": "loyalty",
