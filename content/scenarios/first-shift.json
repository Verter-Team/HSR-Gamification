    "s_noticket": {
      "id": "s_noticket",
      "kind": "scene",
      "text": "Через 10 минут выясняется, что у пассажира билет на завтрашний поезд. Начальник поезда спрашивает, как он прошёл в вагон.",
      "next": "q2"
    },
    "s_complaint": {
      "id": "s_complaint",
      "kind": "scene",
      "text": "Пассажир остаётся на платформе и пишет жалобу. Позже выясняется, что билет у него был.",
      "next": "q2"
