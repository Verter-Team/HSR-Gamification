            {
              "op": "metric",
              "metric": "safety",
              "delta": -15
            },
            {
              "op": "metric",
              "metric": "loyalty",
              "delta": 10
            }
          ],
          "feedback": {
            "verdict": "wrong",
            "text": "Пассажир доволен, но в вагоне оказался человек без подтверждённого билета. Проверка должна быть до отправления.",
            "showImmediately": false
          },
          "next": "s_noticket"
        },
        {
          "id": "c",
          "text": "Сразу отказать в посадке без билета на экране",
          "effects": [
            {
              "op": "metric",
              "metric": "safety",
              "delta": 5
            },
            {
              "op": "metric",
              "metric": "loyalty",
              "delta": -15
            },
            {
              "op": "track",
              "track": "service",
              "amount": 5
            }
          ],
          "feedback": {
            "verdict": "acceptable",
            "text": "Порядок соблюдён, но способы проверки не использованы. Пассажир мог иметь право на проезд.",
            "showImmediately": false
          },
          "next": "s_complaint"
        }
      ],
      "timer": {
        "seconds": 15,
        "onTimeout": {
          "effects": [
            {
              "op": "metric",
              "metric": "safety",
              "delta": -5
            },
            {
              "op": "metric",
              "metric": "loyalty",
              "delta": -10
            }
          ],
          "feedback": {
            "verdict": "wrong",
            "text": "Пока вы думали, очередь встала, посадка задерживается.",
            "showImmediately": false
          },
          "next": "s_queue"
        }
      }
